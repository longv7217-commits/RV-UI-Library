            if opts.Callback then pcall(opts.Callback, key) end
        elseif not listening and input.KeyCode.Name == key then
            if opts.Callback then pcall(opts.Callback, key) end
        end
    end)

    if flag then
        self.Self.Flags[flag] = key
        self.Self.Options[flag] = { SetValue = function(_, v)
            key = v
            keyBtn.Text = tostring(v)
        end }
    end
    return c
