        local btn = NewInst("TextButton", {Parent = box, Size = UDim2.new(1, -32, 0, 38), Position = UDim2.new(0, 16, 0, 132 + y), BackgroundColor3 = isPrimary and th.Accent or th.Panel, BorderSizePixel = 0, Text = b.Text or "OK", TextColor3 = isPrimary and ContrastColor(th.Accent) or th.Text, Font = th.FontBold, TextSize = 13, AutoButtonColor = false, ZIndex = 12})
