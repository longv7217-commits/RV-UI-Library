        Create("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            Parent = page,
        })

        local tabObj = {Name = name, Button = btn, Page = page, Self = self.Self, TabsHolder = self.TabsHolder, Content = self.Content}
        setmetatable(tabObj, getmetatable(self))
        tabObj.__index = getmetatable(self)
        tabObj._isTab = true

        local tabMetatable = {}
        tabMetatable.__index = function(t, k)
            local creators = {"CreateButton","CreateToggle","CreateSlider","CreateInput","CreateDropdown","CreateKeybind","CreateLabel","CreateSection","CreateColorPicker"}
            for _, cn in ipairs(creators) do
                if k == cn then return Library[cn] end
            end
            return rawget(t, k)
        end
        setmetatable(tabObj, tabMetatable)

        btn.MouseButton1Click:Connect(function()
            self:SelectTab(tabObj)
        end)

        table.insert(self.Tabs, tabObj)
        if #self.Tabs == 1 then
            self:SelectTab(tabObj)
        end
        return tabObj
    end

    function Window:SelectTab(tab)
        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            Tween(t.Button, 0.15, {BackgroundColor3 = self.Self.Theme.Tertiary, TextColor3 = self.Self.Theme.TextDim})
        end
        tab.Page.Visible = true
        Tween(tab.Button, 0.15, {BackgroundColor3 = self.Self.Theme.Accent, TextColor3 = Color3.new(1,1,1)})
        self.ActiveTab = tab
    end

    self:_AddSettingsTab(Window)

    return Window
end

function Library:_AddSettingsTab(window)
    local tab = window:CreateTab("⚙ Settings")
    local self = self

    tab:CreateToggle({
        Name = "Key System",
        CurrentValue = false,
        Flag = "KeySystem_Enabled",
        Callback = function(v)
            self:Notify({Title="Config", Content="Key system flag = "..tostring(v)})
        end,
    })

    tab:CreateInput({
        Name = "Config Name",
        Placeholder = "default",
        Flag = "Config_Name",
        Callback = function(text)
            self.CurrentConfig = text ~= "" and text or "default"
        end,
    })

    tab:CreateButton({
        Name = "💾 Save Config",
        Callback = function()
            self:SaveConfig(self.CurrentConfig)
        end,
    })

    tab:CreateButton({
        Name = "📂 Load Config",
        Callback = function()
            self:LoadConfig(self.CurrentConfig)
        end,
    })

    tab:CreateButton({
        Name = "🗑 Delete Config",
        Callback = function()
            local path = self.ConfigFolder .. "/" .. self.CurrentConfig .. ".json"
            if isfile and isfile(path) then
                delfile(path)
                self:Notify({Title="Config", Content="Deleted: "..self.CurrentConfig})
            else
                self:Notify({Title="Config", Content="Config not found."})
            end
        end,
    })

    tab:CreateDropdown({
        Name = "Load Existing",
        Options = self:ListConfigs(),
        Flag = "Config_Select",
        Callback = function(opt)
            if opt and opt ~= "" then
                self.CurrentConfig = opt
                self:LoadConfig(opt)
            end
        end,
    })
end

local function CreateElementBase(self, page, height)
    local container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, height or 40),
        BackgroundColor3 = self.Theme.Tertiary,
        BorderSizePixel = 0,
        Parent = page,
    })
    Round(container, 6)
    Stroke(container, self.Theme.Stroke, 1, 0.5)
    return container
end

function Library:CreateButton(opts)
    local page = self.Page or (self.Self and self.Self)
    page = self.Page
    local container = CreateElementBase(self.Self, page, 36)

    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = "  " .. (opts.Name or "Button"),
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = container,
    })
    Create("UIPadding", {PaddingLeft = UDim.new(0, 8), Parent = btn})

    btn.MouseEnter:Connect(function() Tween(container, 0.15, {BackgroundColor3 = self.Self.Theme.Secondary}) end)
    btn.MouseLeave:Connect(function() Tween(container, 0.15, {BackgroundColor3 = self.Self.Theme.Tertiary}) end)
    btn.MouseButton1Click:Connect(function()
        if opts.Callback then
            local ok, err = pcall(opts.Callback)
            if not ok then warn("[RvUi] Callback error:", err) end
        end
    end)
    return container
end

function Library:CreateToggle(opts)
    local container = CreateElementBase(self.Self, self.Page, 36)
    local state = opts.CurrentValue or false
    local flag = opts.Flag

    local label = Create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Toggle",
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = container,
    })

    local switch = Create("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundColor3 = state and self.Self.Theme.Accent or self.Self.Theme.Secondary,
        BorderSizePixel = 0,
        Parent = container,
    })
    Round(switch, 10)

    local knob = Create("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
        Parent = switch,
    })
    Round(knob, 8)

    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = container,
        ZIndex = 3,
    })

    local function set(v, fire)
        state = v
        Tween(switch, 0.15, {BackgroundColor3 = v and self.Self.Theme.Accent or self.Self.Theme.Secondary})
        Tween(knob, 0.15, {Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
        if flag then self.Self.Flags[flag] = v end
        if fire and opts.Callback then
            local ok, err = pcall(opts.Callback, v)
            if not ok then warn("[RvUi] Toggle callback:", err) end
        end
    end

    if flag then
        self.Self.Flags[flag] = state
        self.Self.Options[flag] = {SetValue = function(_, v) set(v, true) end}
    end

    btn.MouseButton1Click:Connect(function()
        set(not state, true)
    end)
    return container
end

