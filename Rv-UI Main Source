        end
        function Tab:CreateColorThemePicker(name, callback)
            local cp = Tab:CreateColorPicker(name or "Accent Color", Window.Theme.Accent, function(c) Window:SetAccent(c) SafeCallback(callback, c) end)
            return cp
        end

        table.insert(Window.Tabs, Tab)
        return Tab
    end
    table.insert(Library.Windows, Window)
    return Window
end

