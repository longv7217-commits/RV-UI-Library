        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            Tween(t.Button, 0.15, {
                BackgroundColor3 = self.Self.Theme.Tertiary,
                TextColor3 = self.Self.Theme.TextDim,
            })
        end
        tab.Page.Visible = true
        Tween(tab.Button, 0.15, {
            BackgroundColor3 = self.Self.Theme.Accent,
            TextColor3 = self.Self.Theme.Background,
        })
        self.ActiveTab = tab
    end

    self:_AddSettingsTab(Window)
    return Window
end

function Library:_AddSettingsTab(window)
    local tab = window:CreateTab("Settings")
    local self = self

    tab:CreateInput({
        Name = "Config Name",
        Default = self.CurrentConfig,
        Placeholder = "default",
        Flag = "Config_Name",
        Callback = function(text)
            self.CurrentConfig = text ~= "" and text or "default"
        end,
    })

    tab:CreateButton({
        Name = "Save Config",
        Callback = function() self:SaveConfig(self.CurrentConfig) end,
    })

    tab:CreateButton({
        Name = "Load Config",
        Callback = function() self:LoadConfig(self.CurrentConfig) end,
    })

    tab:CreateButton({
        Name = "Delete Config",
        Callback = function()
            local path = self.ConfigFolder .. "/" .. self.CurrentConfig .. ".json"
            if isfile and isfile(path) then
                delfile(path)
                self:Notify({ Title = "Config", Content = "Da xoa: " .. self.CurrentConfig })
            else
                self:Notify({ Title = "Config", Content = "Khong tim thay config." })
            end
        end,
    })

    tab:CreateDropdown({
        Name = "Load Existing",
        Options = self:ListConfigs(),
        Flag = "Config_Select",
        Callback = function(opt)
            if opt and opt ~= "" then
                self.CurrentConfig = opt
                self:LoadConfig(opt)
            end
        end,
    })
end

local function ElementBase(theme, page, height)
    local c = Create("Frame", {
        Size = UDim2.new(1, 0, 0, height or 40),
        BackgroundColor3 = theme.Tertiary,
        BorderSizePixel = 0,
        Parent = page,
    })
    Round(c, 6)
    Stroke(c, theme.Stroke, 1, 0.5)
    return c
end

function Library:CreateButton(opts)
    local c = ElementBase(self.Self.Theme, self.Page, 36)

    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = "   " .. (opts.Name or "Button"),
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        Parent = c,
    })

    btn.MouseEnter:Connect(function()
        Tween(c, 0.15, { BackgroundColor3 = self.Self.Theme.Secondary })
    end)
    btn.MouseLeave:Connect(function()
        Tween(c, 0.15, { BackgroundColor3 = self.Self.Theme.Tertiary })
    end)
    btn.MouseButton1Click:Connect(function()
        if opts.Callback then
            local ok, err = pcall(opts.Callback)
            if not ok then warn("[RvUi] Callback error:", err) end
        end
    end)
    return c
end

function Library:CreateToggle(opts)
    local c = ElementBase(self.Self.Theme, self.Page, 38)
    local state = opts.CurrentValue or false
    local flag = opts.Flag

    Create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Toggle",
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = c,
    })

    local switch = Create("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -54, 0.5, -10),
        BackgroundColor3 = state and self.Self.Theme.Accent or self.Self.Theme.Secondary,
        BorderSizePixel = 0,
        Parent = c,
    })
    Round(switch, 10)

    local knob = Create("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = state and self.Self.Theme.Background or self.Self.Theme.Text,
        BorderSizePixel = 0,
        Parent = switch,
    })
    Round(knob, 8)

    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = c,
        ZIndex = 3,
    })

    local function set(v, fire)
        state = v
        Tween(switch, 0.15, {
            BackgroundColor3 = v and self.Self.Theme.Accent or self.Self.Theme.Secondary,
        })
        Tween(knob, 0.15, {
            Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
            BackgroundColor3 = v and self.Self.Theme.Background or self.Self.Theme.Text,
        })
        if flag then self.Self.Flags[flag] = v end
        if fire and opts.Callback then
            local ok, err = pcall(opts.Callback, v)
            if not ok then warn("[RvUi] Toggle callback:", err) end
        end
    end

    if flag then
        self.Self.Flags[flag] = state
        self.Self.Options[flag] = { SetValue = function(_, v) set(v, true) end }
    end

    btn.MouseButton1Click:Connect(function()
        set(not state, true)
    end)
    return c
end

function Library:CreateSlider(opts)
    local c = ElementBase(self.Self.Theme, self.Page, 52)
    local value = opts.CurrentValue or opts.Min or 0
    local min, max = opts.Min or 0, opts.Max or 100
    local flag = opts.Flag

    Create("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, 20),
        Position = UDim2.new(0, 14, 0, 4),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Slider",
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = c,
    })

    local valueLabel = Create("TextLabel", {
        Size = UDim2.new(0.4, -14, 0, 20),
        Position = UDim2.new(0.6, 0, 0, 4),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = tostring(value),
        TextColor3 = self.Self.Theme.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = c,
    })

    local bar = Create("Frame", {
        Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.new(0, 14, 0, 34),
        BackgroundColor3 = self.Self.Theme.Secondary,
        BorderSizePixel = 0,
        Parent = c,
    })
    Round(bar, 3)

    local fill = Create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = self.Self.Theme.Accent,
        BorderSizePixel = 0,
        Parent = bar,
    })
    Round(fill, 3)

    local knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6),
        BackgroundColor3 = self.Self.Theme.Text,
        BorderSizePixel = 0,
        Parent = bar,
        ZIndex = 2,
    })
    Round(knob, 6)

    local dragging = false
    local function updateFromInput(input)
        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        valueLabel.Text = tostring(value)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -6, 0.5, -6)
        if flag then self.Self.Flags[flag] = value end
        if opts.Callback then
            local ok, err = pcall(opts.Callback, value)
            if not ok then warn("[RvUi] Slider callback:", err) end
        end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if flag then
        self.Self.Flags[flag] = value
        self.Self.Options[flag] = { SetValue = function(_, v)
            value = v
            local rel = (v - min) / (max - min)
            valueLabel.Text = tostring(v)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -6, 0.5, -6)
        end }
    end
    return c
end

