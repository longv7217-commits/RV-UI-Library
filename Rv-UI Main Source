function Library:CreateLoadingScreen(opts)
    opts = opts or {}
    local th = Library.CurrentTheme
    local gui = GetPopupGui()
    local overlay = NewInst("Frame", {Parent = gui, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = th.Background, BorderSizePixel = 0, ZIndex = 50})
    local titleLbl = NewInst("TextLabel", {Parent = overlay, Size = UDim2.new(0, 400, 0, 30), Position = UDim2.new(0.5, -200, 0.5, -60), BackgroundTransparency = 1, Text = opts.Title or "Loading...", TextColor3 = th.Text, Font = th.FontBold, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 51})
    local subLbl = NewInst("TextLabel", {Parent = overlay, Size = UDim2.new(0, 400, 0, 20), Position = UDim2.new(0.5, -200, 0.5, -28), BackgroundTransparency = 1, Text = opts.Subtitle or "Please wait", TextColor3 = th.SubText, Font = th.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 51})
    local bar = NewInst("Frame", {Parent = overlay, Size = UDim2.new(0, 280, 0, 8), Position = UDim2.new(0.5, -140, 0.5, 10), BackgroundColor3 = th.PanelLight, BorderSizePixel = 0, ZIndex = 51})
    AddCorner(bar, 4)
    local fill = NewInst("Frame", {Parent = bar, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = th.Accent, BorderSizePixel = 0, ZIndex = 52})
    AddCorner(fill, 4)
    local pctLbl = NewInst("TextLabel", {Parent = overlay, Size = UDim2.new(0, 100, 0, 18), Position = UDim2.new(0.5, -50, 0.5, 26), BackgroundTransparency = 1, Text = "0%", TextColor3 = th.Accent, Font = th.FontBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 51})
    local obj = {}
    obj.Instance = overlay
    function obj:SetProgress(v)
        local c = ClampNumber(v, 0, 100)
        TweenInst(fill, {Size = UDim2.new(c / 100, 0, 1, 0)}, 0.2)
        pctLbl.Text = tostring(math.floor(c + 0.5)) .. "%"
    end
    function obj:SetText(t) titleLbl.Text = t end
    function obj:SetSubtitle(t) subLbl.Text = t end
    function obj:Close()
        TweenInst(overlay, {BackgroundTransparency = 1}, 0.3)
        task.delay(0.3, function() if overlay then overlay:Destroy() end end)
    end
    function obj:Finish() obj:SetProgress(100) task.delay(0.4, function() obj:Close() end) end
    if opts.Duration and opts.Duration > 0 then
        task.spawn(function()
            local steps = 20
            for i = 1, steps do task.wait(opts.Duration / steps) obj:SetProgress(i * 100 / steps) end
            obj:Finish()
        end)
    end
    return obj
end
function Library:CreateWatermark(opts)
    opts = opts or {}
    local th = Library.CurrentTheme
    local parent = GetGuiParent()
    local gui = parent:FindFirstChild("WindLibraryGui")
    if not gui then gui = NewInst("ScreenGui", {Name = "WindLibraryGui", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}) gui.Parent = parent end
    local wm = NewInst("Frame", {Parent = gui, Size = UDim2.new(0, 220, 0, 32), Position = UDim2.new(0, 12, 0, 12), BackgroundColor3 = th.Panel, BorderSizePixel = 0, ClipsDescendants = true})
    AddCorner(wm, 16)
    AddStroke(wm, th.Stroke, 1)
    local dot = NewInst("Frame", {Parent = wm, Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(0, 12, 0.5, -5), BackgroundColor3 = th.Success, BorderSizePixel = 0})
    AddCorner(dot, 5)
    local lbl = NewInst("TextLabel", {Parent = wm, Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 30, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Library v1.0.0", TextColor3 = th.Text, Font = th.FontBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
    local obj = {}
    obj.Instance = wm
    function obj:SetText(t) lbl.Text = t end
    function obj:SetStatus(color) if IsColor(color) then dot.BackgroundColor3 = color end end
    function obj:SetVisible(v) wm.Visible = v end
    function obj:Destroy() wm:Destroy() end
    task.spawn(function()
        while wm and wm.Parent do
            TweenInst(dot, {BackgroundTransparency = 0.4}, 0.8)
            task.wait(0.8)
            if not wm or not wm.Parent then break end
            TweenInst(dot, {BackgroundTransparency = 0}, 0.8)
            task.wait(0.8)
        end
    end)
    return obj
end
function Library:CreateSettingsTab(window, opts)
    opts = opts or {}
    if not window then return nil end
    local tab = window:CreateTab(opts.TabName or "Settings", opts.Icon or "⚙")
    tab:CreateSection("Appearance")
    tab:CreateThemePicker("Theme", function(v) if opts.OnTheme then SafeCall(opts.OnTheme, v) end end)
    tab:CreateAccentPicker("Accent Color", function(c) if opts.OnAccent then SafeCall(opts.OnAccent, c) end end)
    tab:CreateSection("Window")
    local keybind = tab:CreateKeybind("Toggle Key", window.Keybind or Enum.KeyCode.RightShift, function(k) window:SetKeybind(k) end, {Flag = "WindowKeybind"})
    local searchToggle = tab:CreateToggle("Show Search", true, function(v) window:SetSearchVisible(v) end, {Flag = "ShowSearch"})
    tab:CreateSection("Config")
    tab:CreateConfigPicker("Config", function(action) if opts.OnConfig then SafeCall(opts.OnConfig, action) end end)
    tab:CreateSection("Info")
    tab:CreateParagraph("Version", "Library v" .. Library.Version .. " - Built for Roblox Luau")
    tab:CreateParagraph("About", "Toggle with " .. (window.Keybind and window.Keybind.Name or "RightShift") .. ". Use Theme Picker to change look, Accent Picker to change color, Config to save and load your settings.")
    local closeBtn = tab:CreateButton("Close Window", function() window:Minimize() end)
    local destroyBtn = tab:CreateButton("Destroy UI", function() Library:Destroy() end)
    return {Tab = tab, Keybind = keybind, SearchToggle = searchToggle, CloseButton = closeBtn, DestroyButton = destroyBtn}
end
