    end
    table.insert(Library.Windows, Window)
    if opts.AutoSelectTab and Window.Tabs[opts.AutoSelectTab] then Window.Tabs[opts.AutoSelectTab]:Select() end
    if opts.NotifyOnLoad then Library:Notify({Title = opts.Title or "Library", Content = "Loaded successfully", Type = "success"}) end
