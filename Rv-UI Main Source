--[[
    Combat GUI Library (UI only)
    Author: Realvux
    Version: 1.0.0

    Usage:
        local Library = loadstring(game:HttpGet("URL_HERE"))()

        local gui = Library.new({
            Title    = "ComBat G-U-I",
            Subtitle = "combat gui for combat",
            Version  = "v1.0.0",
            Credit   = "by Realvux",
            Keybind  = Enum.KeyCode.K,
            -- Theme optional, có default
        })

        local tab = gui:Tab("Auto Block")
        tab:Toggle("Auto Block", false, function(v) print(v) end)
        tab:Input("M1 Range", "15", function(text) print(text) end)
        tab:Button("Reset", function() print("reset") end)

        gui:Init()          -- build GUI
        gui:Destroy()       -- xoá GUI
        gui:Toggle()        -- ẩn/hiện
        gui:Notify("hi")    -- (tuỳ chọn)
]]

local Library = {}
Library.__index = Library

-- ============================================================
-- SERVICES
-- ============================================================
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")

-- ============================================================
-- DEFAULT THEME
-- ============================================================
local DEFAULT_THEME = {
    Accent     = Color3.fromRGB(255, 255, 255),
    Background = Color3.fromRGB(12, 12, 12),
    Panel      = Color3.fromRGB(20, 20, 20),
    PanelLight = Color3.fromRGB(28, 28, 28),
    Stroke     = Color3.fromRGB(45, 45, 45),
    Text       = Color3.fromRGB(255, 255, 255),
    SubText    = Color3.fromRGB(170, 170, 170),
    Font       = Enum.Font.GothamMedium,
    FontBold   = Enum.Font.GothamBold,
}

-- ============================================================
-- HELPERS
-- ============================================================
local function newInst(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

local function addStroke(parent, color, thickness, transparency)
    return newInst("UIStroke", {
        Parent = parent,
        Color = color or DEFAULT_THEME.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })
end

local function addCorner(parent, radius)
    return newInst("UICorner", {
        Parent = parent,
        CornerRadius = UDim.new(0, radius or 8)
    })
end

-- ============================================================
-- LIBRARY CONSTRUCTOR
-- ============================================================
function Library.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Library)

    self.Opts = {
        Title    = opts.Title    or "ComBat G-U-I",
        Subtitle = opts.Subtitle or "combat gui for combat (yes it is)",
        Version  = opts.Version  or "v1.0.0",
        Credit   = opts.Credit   or "by Realvux",
        Keybind  = opts.Keybind  or Enum.KeyCode.K,
        Size     = opts.Size     or UDim2.new(0, 560, 0, 380),
    }

    self.Theme = {}
    for k, v in pairs(DEFAULT_THEME) do self.Theme[k] = v end
    if opts.Theme then
        for k, v in pairs(opts.Theme) do self.Theme[k] = v end
    end

    self.Tabs = {}
    self.TabButtons = {}
    self.Pages = {}
    self.Hidden = false
    self.Built = false
    return self
end

-- ============================================================
-- INTERNAL: BUILD SHELL
-- ============================================================
function Library:Init()
    if self.Built then return self end
    self.Built = true

    local T = self.Theme
    local O = self.Opts

    -- Cleanup old
    local old = CoreGui:FindFirstChild("CombatGui")
    if old then old:Destroy() end

    local ScreenGui = newInst("ScreenGui", {
        Name = "CombatGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    ScreenGui.Parent = CoreGui
    self.ScreenGui = ScreenGui

    local Main = newInst("Frame", {
        Parent = ScreenGui,
        Size = O.Size,
        Position = UDim2.new(0.5, -O.Size.X.Offset / 2, 0.5, -O.Size.Y.Offset / 2),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
        Draggable = true,
    })
    addCorner(Main, 12)
    addStroke(Main, T.Stroke, 1.5)
    self.Main = Main

    -- TopBar
    local TopBar = newInst("Frame", {
        Parent = Main,
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
    })
    addCorner(TopBar, 12)
    newInst("Frame", {
        Parent = TopBar,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
    })

    local LogoDot = newInst("Frame", {
        Parent = TopBar,
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 16, 0.5, -6),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    })
    addCorner(LogoDot, 6)

    newInst("TextLabel", {
        Parent = TopBar,
        Size = UDim2.new(0, 300, 0, 20),
        Position = UDim2.new(0, 38, 0, 5),
        BackgroundTransparency = 1,
        Text = O.Title .. "  " .. O.Version,
        TextColor3 = T.Text,
        Font = T.FontBold,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    newInst("TextLabel", {
        Parent = TopBar,
        Size = UDim2.new(0, 300, 0, 14),
        Position = UDim2.new(0, 38, 0, 23),
        BackgroundTransparency = 1,
        Text = O.Subtitle .. "  •  " .. O.Credit,
        TextColor3 = T.SubText,
        Font = T.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local CloseBtn = newInst("TextButton", {
        Parent = TopBar,
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(1, -36, 0.5, -14),
        BackgroundColor3 = T.PanelLight,
        BorderSizePixel = 0,
        Text = "X",
        TextColor3 = T.Text,
        Font = T.FontBold,
        TextSize = 14,
        AutoButtonColor = false,
    })
    addCorner(CloseBtn, 6)
    self.CloseBtn = CloseBtn

    -- TabBar
    local TabBar = newInst("Frame", {
        Parent = Main,
        Size = UDim2.new(0, 140, 1, -42),
        Position = UDim2.new(0, 0, 0, 42),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
    })
    self.TabBar = TabBar

    -- Content
    local Content = newInst("Frame", {
        Parent = Main,
        Size = UDim2.new(1, -140, 1, -42),
        Position = UDim2.new(0, 140, 0, 42),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })
    self.Content = Content

    -- Mini toggle
    local MiniToggle = newInst("TextButton", {
        Parent = ScreenGui,
        Size = UDim2.new(0, 36, 0, 36),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
        Text = "≡",
        TextColor3 = T.Text,
        Font = T.FontBold,
        TextSize = 16,
        AutoButtonColor = false,
        Active = true,
        Draggable = true,
    })
    addCorner(MiniToggle, 8)
    addStroke(MiniToggle, T.Stroke, 1)
    self.MiniToggle = MiniToggle

    -- Events
    CloseBtn.MouseButton1Click:Connect(function()
        self.Hidden = true
        Main.Visible = false
    end)

    MiniToggle.MouseButton1Click:Connect(function()
        self:Toggle()
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == O.Keybind then
            self:Toggle()
        end
    end)

    return self
end

-- ============================================================
-- PUBLIC API
-- ============================================================
function Library:Toggle()
    if not self.Main then return end
    self.Hidden = not self.Hidden
    self.Main.Visible = not self.Hidden
end

function Library:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
    end
    self.Built = false
end

function Library:Tab(name)
    if not self.Built then self:Init() end
    local T = self.Theme
    local self_ = self

    local order = #self.Tabs + 1
    local btn = newInst("TextButton", {
        Parent = self.TabBar,
        Size = UDim2.new(1, -16, 0, 34),
        Position = UDim2.new(0, 8, 0, 8 + (order - 1) * 40),
        BackgroundColor3 = T.PanelLight,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = T.SubText,
        Font = T.Font,
        TextSize = 13,
        AutoButtonColor = false,
    })
    addCorner(btn, 6)

    local page = newInst("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = T.Stroke,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = (order == 1),
    })

    newInst("UIPadding", {
        Parent = page,
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 12),
    })

    newInst("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    btn.MouseButton1Click:Connect(function()
        for _, other in ipairs(self_.TabBar:GetChildren()) do
            if other:IsA("TextButton") then
                other.BackgroundColor3 = T.PanelLight
                other.TextColor3 = T.SubText
            end
        end
        btn.BackgroundColor3 = T.Accent
        btn.TextColor3 = T.Background
        for _, other in ipairs(self_.Content:GetChildren()) do
            if other:IsA("ScrollingFrame") then
                other.Visible = false
            end
        end
        page.Visible = true
    end)

    if order == 1 then
        btn.BackgroundColor3 = T.Accent
        btn.TextColor3 = T.Background
    end

    table.insert(self.Tabs, name)
    table.insert(self.TabButtons, btn)
    table.insert(self.Pages, page)

    -- Return tab controller
    local Tab = {}
    Tab.__index = Tab
    Tab.Page = page
    Tab.Lib  = self
    return setmetatable(Tab, Tab)
end

-- ============================================================
-- WIDGETS (methods on tab)
-- ============================================================
local TabMethods = {}

function TabMethods:Toggle(name, default, callback)
    local T = self.Lib.Theme
    local holder = newInst("Frame", {
        Parent = self.Page,
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
    })
    addCorner(holder, 8)
    addStroke(holder, T.Stroke, 1)

    newInst("TextLabel", {
        Parent = holder,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = T.Text,
        Font = T.Font,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local swBg = newInst("Frame", {
        Parent = holder,
        Size = UDim2.new(0, 46, 0, 24),
        Position = UDim2.new(1, -60, 0.5, -12),
        BackgroundColor3 = default and T.Accent or T.Stroke,
        BorderSizePixel = 0,
    })
    addCorner(swBg, 12)

    local knob = newInst("Frame", {
        Parent = swBg,
        Size = UDim2.new(0, 18, 0, 18),
        Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = default and T.Background or T.Text,
        BorderSizePixel = 0,
    })
    addCorner(knob, 9)

    local btn = newInst("TextButton", {
        Parent = holder,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
    })

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(swBg, TweenInfo.new(0.18), {
            BackgroundColor3 = state and T.Accent or T.Stroke
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
            BackgroundColor3 = state and T.Background or T.Text
        }):Play()
        if callback then callback(state) end
    end)

    -- API: Set / Get / SetVisible
    holder.Set = function(_, v)
        state = v
        swBg.BackgroundColor3 = state and T.Accent or T.Stroke
        knob.Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        knob.BackgroundColor3 = state and T.Background or T.Text
        if callback then callback(state) end
    end
    holder.Get = function() return state end
    holder.SetVisible = function(_, v)
        holder.Visible = v
        holder.Size = v and UDim2.new(1, 0, 0, 44) or UDim2.new(1, 0, 0, 0)
    end

    return holder
end

function TabMethods:Input(name, default, callback)
    local T = self.Lib.Theme
    local holder = newInst("Frame", {
        Parent = self.Page,
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
    })
    addCorner(holder, 8)
    addStroke(holder, T.Stroke, 1)

    newInst("TextLabel", {
        Parent = holder,
        Size = UDim2.new(0, 220, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = T.Text,
        Font = T.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local box = newInst("TextBox", {
        Parent = holder,
        Size = UDim2.new(0, 110, 0, 28),
        Position = UDim2.new(1, -124, 0.5, -14),
        BackgroundColor3 = T.PanelLight,
        BorderSizePixel = 0,
        Text = tostring(default),
        TextColor3 = T.Text,
        Font = T.Font,
        TextSize = 12,
        PlaceholderText = "value",
        PlaceholderColor3 = T.SubText,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    addCorner(box, 6)
    addStroke(box, T.Stroke, 1)

    box.Focused:Connect(function()
        TweenService:Create(box, TweenInfo.new(0.15), {
            BackgroundColor3 = T.Accent
        }):Play()
        box.TextColor3 = T.Background
    end)
    box.FocusLost:Connect(function()
        TweenService:Create(box, TweenInfo.new(0.15), {
            BackgroundColor3 = T.PanelLight
        }):Play()
        box.TextColor3 = T.Text
        if callback then callback(box.Text) end
    end)

    holder.Set = function(_, v)
        box.Text = tostring(v)
        if callback then callback(box.Text) end
    end
    holder.Get = function() return box.Text end
    holder.SetVisible = function(_, v)
        holder.Visible = v
        holder.Size = v and UDim2.new(1, 0, 0, 44) or UDim2.new(1, 0, 0, 0)
    end

    return holder, box
end

function TabMethods:Button(name, callback)
    local T = self.Lib.Theme
    local btn = newInst("TextButton", {
        Parent = self.Page,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = T.Text,
        Font = T.Font,
        TextSize = 13,
        AutoButtonColor = false,
    })
    addCorner(btn, 8)
    addStroke(btn, T.Stroke, 1)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = T.PanelLight
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = T.Panel
        }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)

    return btn
end

function TabMethods:Label(text)
    local T = self.Lib.Theme
    local lbl = newInst("TextLabel", {
        Parent = self.Page,
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = T.SubText,
        Font = T.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    return lbl
end

function TabMethods:Divider()
    local T = self.Lib.Theme
    local d = newInst("Frame", {
        Parent = self.Page,
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = T.Stroke,
        BorderSizePixel = 0,
    })
    return d
end

-- attach methods to tab metatable
local TabMeta = {}
TabMeta.__index = function(t, k)
    if TabMethods[k] then return TabMethods[k] end
    return rawget(t, k)
end

-- override Library:Tab to use new meta
local oldTab = Library.Tab
function Library:Tab(name)
    if not self.Built then self:Init() end
    local T = self.Theme
    local self_ = self

    local order = #self.Tabs + 1
    local btn = newInst("TextButton", {
        Parent = self.TabBar,
        Size = UDim2.new(1, -16, 0, 34),
        Position = UDim2.new(0, 8, 0, 8 + (order - 1) * 40),
        BackgroundColor3 = T.PanelLight,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = T.SubText,
        Font = T.Font,
        TextSize = 13,
        AutoButtonColor = false,
    })
    addCorner(btn, 6)

    local page = newInst("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = T.Stroke,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = (order == 1),
    })

    newInst("UIPadding", {
        Parent = page,
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 12),
    })

    newInst("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    btn.MouseButton1Click:Connect(function()
        for _, other in ipairs(self_.TabBar:GetChildren()) do
            if other:IsA("TextButton") then
                other.BackgroundColor3 = T.PanelLight
                other.TextColor3 = T.SubText
            end
        end
        btn.BackgroundColor3 = T.Accent
        btn.TextColor3 = T.Background
        for _, other in ipairs(self_.Content:GetChildren()) do
            if other:IsA("ScrollingFrame") then
                other.Visible = false
            end
        end
        page.Visible = true
    end)

    if order == 1 then
        btn.BackgroundColor3 = T.Accent
        btn.TextColor3 = T.Background
    end

    table.insert(self.Tabs, name)
    table.insert(self.TabButtons, btn)
    table.insert(self.Pages, page)

    return setmetatable({
        Page = page,
        Lib  = self,
        Name = name,
    }, TabMeta)
end

-- ============================================================
-- RETURN
-- ============================================================
return Library
