            function o:Get() return o.Value end
            function o:SetOptions(n) options = n o.Options = n if o._open then closeList() openList() end end
            function o:Close() closeList() end
            function o:Destroy() closeList() holder:Destroy() end
            function o:RefreshTheme(nt) th2 = nt holder.BackgroundColor3 = nt.Panel lbl.TextColor3 = nt.Text sel.BackgroundColor3 = nt.PanelLight sel.TextColor3 = nt.Text end
