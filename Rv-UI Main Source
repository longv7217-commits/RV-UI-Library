        function Tab:CreateDropdown(name, options, default, callback)
            options = options or {}
            local holder = newInst("Frame", {
                Parent = page,
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
                ClipsDescendants = false,
            })
            addCorner(holder, 8)
            addStroke(holder, theme.Stroke, 1)

            local label = newInst("TextLabel", {
                Parent = holder,
                Size = UDim2.new(0, 200, 1, 0),
                Position = UDim2.new(0, 14, 0, 0),
                BackgroundTransparency = 1,
                Text = name or "",
                TextColor3 = theme.Text,
                Font = theme.Font,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            local selected = newInst("TextButton", {
                Parent = holder,
                Size = UDim2.new(0, 130, 0, 28),
                Position = UDim2.new(1, -144, 0.5, -14),
                BackgroundColor3 = theme.PanelLight,
                BorderSizePixel = 0,
                Text = tostring(default or "Select"),
                TextColor3 = theme.Text,
                Font = theme.Font,
                TextSize = 12,
                AutoButtonColor = false,
                ClipsDescendants = true,
            })
            addCorner(selected, 6)
            addStroke(selected, theme.Stroke, 1)

            local list = newInst("ScrollingFrame", {
                Parent = holder,
                Size = UDim2.new(0, 130, 0, 0),
                Position = UDim2.new(1, -144, 1, 4),
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
                ScrollBarThickness = 2,
                ScrollBarImageColor3 = theme.Stroke,
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                Visible = false,
                ZIndex = 100,
                ClipsDescendants = true,
            })
            addCorner(list, 6)
            addStroke(list, theme.Stroke, 1)
            local listLayout = newInst("UIListLayout", {
                Parent = list,
                Padding = UDim.new(0, 2),
                SortOrder = Enum.SortOrder.LayoutOrder,
            })
            newInst("UIPadding", {
                Parent = list,
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4),
                PaddingRight = UDim.new(0, 4),
            })

            local isOpen = false
            local obj = {}
            obj.Instance = holder
            obj.Value = default or (options[1])

            local function buildList()
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for i, opt in ipairs(options) do
                    local item = newInst("TextButton", {
                        Parent = list,
                        Size = UDim2.new(1, 0, 0, 26),
                        BackgroundColor3 = theme.PanelLight,
                        BorderSizePixel = 0,
                        Text = tostring(opt),
                        TextColor3 = theme.Text,
                        Font = theme.Font,
                        TextSize = 12,
                        AutoButtonColor = false,
                        LayoutOrder = i,
                    })
                    addCorner(item, 4)
                    item.MouseEnter:Connect(function()
                        tween(item, { BackgroundColor3 = theme.Accent }, 0.12)
                        item.TextColor3 = theme.Background
                    end)
                    item.MouseLeave:Connect(function()
                        tween(item, { BackgroundColor3 = theme.PanelLight }, 0.12)
                        item.TextColor3 = theme.Text
                    end)
                    item.MouseButton1Click:Connect(function()
                        obj.Value = opt
                        selected.Text = tostring(opt)
                        if callback then task.spawn(function() callback(opt) end) end
                        obj:Close()
                    end)
                end
            end

            function obj:Open()
                if isOpen then return end
                isOpen = true
                buildList()
                list.Visible = true
                list.Size = UDim2.new(0, 130, 0, 0)
                local target = math.min(#options * 28 + 8, 200)
                tween(list, { Size = UDim2.new(0, 130, 0, target) }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            end
            function obj:Close()
                if not isOpen then return end
                isOpen = false
                tween(list, { Size = UDim2.new(0, 130, 0, 0) }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                task.delay(0.18, function()
                    if not isOpen then list.Visible = false end
                end)
            end
            function obj:Toggle()
                if isOpen then obj:Close() else obj:Open() end
            end
            function obj:Set(v)
                obj.Value = v
                selected.Text = tostring(v)
                if callback then task.spawn(function() callback(v) end) end
            end
            function obj:Get() return obj.Value end
            function obj:SetOptions(newOptions)
                options = newOptions
                if isOpen then buildList() end
            end
            function obj:Destroy() holder:Destroy() end

            selected.MouseButton1Click:Connect(function()
                ripple(selected, theme.Accent)
                obj:Toggle()
            end)

            return obj
        end

        function Tab:CreateColorPicker(name, default, callback)
            default = default or Color3.fromRGB(255, 255, 255)
            local holder = newInst("Frame", {
                Parent = page,
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
            })
            addCorner(holder, 8)
            addStroke(holder, theme.Stroke, 1)

            newInst("TextLabel", {
                Parent = holder,
                Size = UDim2.new(0, 200, 1, 0),
                Position = UDim2.new(0, 14, 0, 0),
                BackgroundTransparency = 1,
                Text = name or "",
                TextColor3 = theme.Text,
                Font = theme.Font,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            local swatch = newInst("TextButton", {
                Parent = holder,
                Size = UDim2.new(0, 60, 0, 28),
                Position = UDim2.new(1, -74, 0.5, -14),
                BackgroundColor3 = default,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
            })
            addCorner(swatch, 6)
            addStroke(swatch, theme.Stroke, 1)

            local popup = newInst("Frame", {
                Parent = holder,
                Size = UDim2.new(0, 200, 0, 140),
                Position = UDim2.new(1, -200, 1, 4),
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 100,
            })
            addCorner(popup, 8)
            addStroke(popup, theme.Stroke, 1)

            local function makeSlider(parent, y, labelText)
                local lbl = newInst("TextLabel", {
                    Parent = parent,
                    Size = UDim2.new(0, 40, 0, 16),
                    Position = UDim2.new(0, 10, 0, y),
                    BackgroundTransparency = 1,
                    Text = labelText,
                    TextColor3 = theme.SubText,
                    Font = theme.Font,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                local bg = newInst("Frame", {
                    Parent = parent,
                    Size = UDim2.new(0, 140, 0, 6),
                    Position = UDim2.new(0, 50, 0, y + 5),
                    BackgroundColor3 = theme.PanelLight,
                    BorderSizePixel = 0,
                })
                addCorner(bg, 3)
                local fill = newInst("Frame", {
                    Parent = bg,
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel = 0,
                })
                addCorner(fill, 3)
                local knob = newInst("Frame", {
                    Parent = bg,
                    Size = UDim2.new(0, 12, 0, 12),
                    Position = UDim2.new(1, -6, 0.5, -6),
                    BackgroundColor3 = theme.Text,
                    BorderSizePixel = 0,
                    ZIndex = 2,
                })
                addCorner(knob, 6)
                return bg, fill, knob
            end

            local rBg, rFill, rKnob = makeSlider(popup, 10, "R")
            local gBg, gFill, gKnob = makeSlider(popup, 40, "G")
            local bBg, bFill, bKnob = makeSlider(popup, 70, "B")

            local current = default
            local obj = {}
            obj.Instance = holder
            obj.Value = current

            local dragging = nil
            local function updateColor()
                swatch.BackgroundColor3 = current
                if callback then task.spawn(function() callback(current) end) end
            end

            local function setChannel(ch, v)
                v = math.clamp(v, 0, 1)
                if ch == "R" then
                    current = Color3.new(v, current.G, current.B)
                    rFill.Size = UDim2.new(v, 0, 1, 0)
                    rKnob.Position = UDim2.new(v, -6, 0.5, -6)
                elseif ch == "G" then
                    current = Color3.new(current.R, v, current.B)
                    gFill.Size = UDim2.new(v, 0, 1, 0)
                    gKnob.Position = UDim2.new(v, -6, 0.5, -6)
                else
                    current = Color3.new(current.R, current.G, v)
                    bFill.Size = UDim2.new(v, 0, 1, 0)
                    bKnob.Position = UDim2.new(v, -6, 0.5, -6)
                end
                updateColor()
            end

            local function bindSlider(bg, ch)
                bg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = ch
                        local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                        setChannel(ch, rel)
                    end
                end)
            end
            bindSlider(rBg, "R")
            bindSlider(gBg, "G")
            bindSlider(bBg, "B")

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local bg = dragging == "R" and rBg or (dragging == "G" and gBg or bBg)
                    local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                    setChannel(dragging, rel)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = nil
                end
            end)

            rFill.Size = UDim2.new(default.R, 0, 1, 0)
            rKnob.Position = UDim2.new(default.R, -6, 0.5, -6)
            gFill.Size = UDim2.new(default.G, 0, 1, 0)
            gKnob.Position = UDim2.new(default.G, -6, 0.5, -6)
            bFill.Size = UDim2.new(default.B, 0, 1, 0)
            bKnob.Position = UDim2.new(default.B, -6, 0.5, -6)

            local isOpen = false
            swatch.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                popup.Visible = true
                if isOpen then
                    popup.Size = UDim2.new(0, 200, 0, 0)
                    tween(popup, { Size = UDim2.new(0, 200, 0, 100) }, 0.2)
                else
                    tween(popup, { Size = UDim2.new(0, 200, 0, 0) }, 0.18)
                    task.delay(0.18, function()
                        if not isOpen then popup.Visible = false end
                    end)
                end
            end)

            function obj:Set(c)
                current = c
                obj.Value = c
                rFill.Size = UDim2.new(c.R, 0, 1, 0)
                rKnob.Position = UDim2.new(c.R, -6, 0.5, -6)
                gFill.Size = UDim2.new(c.G, 0, 1, 0)
                gKnob.Position = UDim2.new(c.G, -6, 0.5, -6)
                bFill.Size = UDim2.new(c.B, 0, 1, 0)
                bKnob.Position = UDim2.new(c.B, -6, 0.5, -6)
                updateColor()
            end
            function obj:Get() return current end
            function obj:Destroy() holder:Destroy() end

            return obj
        end

        function Tab:CreateKeybind(name, default, callback)
            local holder = newInst("Frame", {
                Parent = page,
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
            })
            addCorner(holder, 8)
            addStroke(holder, theme.Stroke, 1)

            newInst("TextLabel", {
                Parent = holder,
                Size = UDim2.new(0, 200, 1, 0),
                Position = UDim2.new(0, 14, 0, 0),
                BackgroundTransparency = 1,
                Text = name or "",
                TextColor3 = theme.Text,
                Font = theme.Font,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            local keyBtn = newInst("TextButton", {
                Parent = holder,
                Size = UDim2.new(0, 90, 0, 28),
                Position = UDim2.new(1, -104, 0.5, -14),
                BackgroundColor3 = theme.PanelLight,
                BorderSizePixel = 0,
                Text = default and default.Name or "None",
                TextColor3 = theme.Text,
                Font = theme.Font,
                TextSize = 12,
                AutoButtonColor = false,
            })
            addCorner(keyBtn, 6)
            addStroke(keyBtn, theme.Stroke, 1)

            local current = default
            local listening = false
            local obj = {}
            obj.Instance = holder
            obj.Value = current

            local conn
            keyBtn.MouseButton1Click:Connect(function()
                if listening then return end
                listening = true
                keyBtn.Text = "..."
                local inputConn
                inputConn = UserInputService.InputBegan:Connect(function(input, gp)
                    if gp then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        current = input.KeyCode
                        obj.Value = current
                        keyBtn.Text = current.Name
                        listening = false
                        if inputConn then inputConn:Disconnect() end
                        if callback then task.spawn(function() callback(current) end) end
                    end
                end)
            end)

            if default then
                conn = UserInputService.InputBegan:Connect(function(input, gp)
                    if gp then return end
                    if input.KeyCode == current and callback then
                        task.spawn(function() callback(current) end)
                    end
                end)
            end

            function obj:Set(k)
                current = k
                obj.Value = k
                keyBtn.Text = k and k.Name or "None"
            end
            function obj:Get() return current end
            function obj:Destroy() holder:Destroy() end
            return obj
        end

        table.insert(Window.Tabs, Tab)
        return Tab
    end

    return Window
end

