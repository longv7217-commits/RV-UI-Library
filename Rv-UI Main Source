local NotifHolder
local function GetNotifHolder()
    if NotifHolder and NotifHolder.Parent then return NotifHolder end
    local gui = CoreGui:FindFirstChild("RvUi")
    if not gui then return nil end
    NotifHolder = gui:FindFirstChild("Notifications")
    return NotifHolder
end

function Library:Notify(opts)
    opts = opts or {}
    local holder = GetNotifHolder()
    if not holder then return end

    local count = 0
    for _, c in pairs(holder:GetChildren()) do
        if c:IsA("Frame") then count = count + 1 end
    end

    local frame = Create("Frame", {
        Size = UDim2.new(0, 300, 0, 76),
        Position = UDim2.new(1, 320, 1, -20 - (count * 86)),
        BackgroundColor3 = self.Theme.Secondary,
        BorderSizePixel = 0,
        Parent = holder,
    })
    Round(frame, 8)
    Stroke(frame, self.Theme.Stroke, 1)

    local bar = Create("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        Parent = frame,
    })
    Round(bar, 2)

    Create("TextLabel", {
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.new(0, 18, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = opts.Title or "Notification",
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -30, 1, -35),
        Position = UDim2.new(0, 18, 0, 28),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Content or "",
        TextColor3 = self.Theme.TextDim,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = frame,
    })

    Tween(frame, 0.3, { Position = UDim2.new(1, -320, 1, -20 - (count * 86)) })

    task.delay(opts.Duration or 5, function()
        if frame and frame.Parent then
            Tween(frame, 0.3, { Position = UDim2.new(1, 320, frame.Position.Y.Scale, frame.Position.Y.Offset) })
            task.wait(0.3)
            frame:Destroy()
        end
    end)
end

function Library:SaveConfig(name)
    name = name or self.CurrentConfig
    if not isfolder or not writefile then
        self:Notify({ Title = "Config", Content = "Executor khong ho tro save file." })
        return
    end
    if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
    writefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(self.Flags))
    self:Notify({ Title = "Config Saved", Content = "Da luu: " .. name })
end

function Library:LoadConfig(name)
    name = name or self.CurrentConfig
    if not isfile then return end
    local path = self.ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then
        self:Notify({ Title = "Config", Content = "Khong tim thay: " .. name })
        return
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok then
        self:Notify({ Title = "Config", Content = "Load that bai." })
        return
    end
    for flag, value in pairs(data) do
        self.Flags[flag] = value
        if self.Options[flag] then
            pcall(function() self.Options[flag]:SetValue(value) end)
        end
    end
    self:Notify({ Title = "Config Loaded", Content = "Da load: " .. name })
end

function Library:ListConfigs()
    if not listfiles or not isfolder(self.ConfigFolder) then return {} end
    local list = {}
    for _, f in pairs(listfiles(self.ConfigFolder)) do
        local n = f:match("([^/\\]+)%.json$")
        if n then table.insert(list, n) end
    end
    return list
end

local function MakeDraggable(frame, dragArea)
    dragArea = dragArea or frame
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local startMouse = input.Position
        local startPos   = frame.Position
        local active     = true

        local moveConn
        moveConn = UserInputService.InputChanged:Connect(function(i)
            if not active then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
            local delta = i.Position - startMouse
            local vp = workspace.CurrentCamera.ViewportSize
            local nx = math.clamp(startPos.X.Offset + delta.X, -frame.AbsoluteSize.X + 60, vp.X - 60)
            local ny = math.clamp(startPos.Y.Offset + delta.Y, 36, vp.Y - 40)
            frame.Position = UDim2.new(0, nx, 0, ny)
        end)

        local endConn
        endConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                active = false
                moveConn:Disconnect()
                endConn:Disconnect()
            end
        end)
    end)
end

