local function Ripple(button, color)
    if button == nil or button.Parent == nil then return end
    local r = NewInst("Frame", {Parent = button, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color or Library.CurrentTheme.Accent, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 50})
    AddCorner(r, 100)
    local sz = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.2
    TweenInst(r, {Size = UDim2.new(0, sz, 0, sz), BackgroundTransparency = 1}, 0.45)
    task.delay(0.5, function() if r then r:Destroy() end end)
end
