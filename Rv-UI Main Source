            local valLbl = NewInst("TextLabel", {Parent = holder, Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -74, 0, 6), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = th2.Accent, Font = th2.FontBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right})
            local bar = NewInst("Frame", {Parent = holder, Size = UDim2.new(1, -28, 0, 6), Position = UDim2.new(0, 14, 0, 36), BackgroundColor3 = th2.PanelLight, BorderSizePixel = 0}) Corner(bar, 3)
            local fill = NewInst("Frame", {Parent = bar, Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = th2.Accent, BorderSizePixel = 0}) Corner(fill, 3)
            local knob = NewInst("Frame", {Parent = bar, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7), BackgroundColor3 = th2.Text, BorderSizePixel = 0, ZIndex = 2}) Corner(knob, 7)
            local dragging = false
            local o = {} o.Instance = holder o.Value = default o.Type = "Slider" o.Min = min o.Max = max
            local function fmt(v) if decimals == 0 then return tostring(math.floor(v + 0.5)) end local m = 10 ^ decimals return tostring(math.floor(v * m + 0.5) / m) end
            local function apply(v, fire) v = ClampNumber(v, min, max) if decimals == 0 then v = math.floor(v + 0.5) else local m = 10 ^ decimals v = math.floor(v * m + 0.5) / m end o.Value = v local rel = (v - min) / (max - min) fill.Size = UDim2.new(rel, 0, 1, 0) knob.Position = UDim2.new(rel, -7, 0.5, -7) valLbl.Text = fmt(v) if fire ~= false then SafeCallback(callback, v) end end
            local function fromX(x) local rel = ClampNumber((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1) apply(min + (max - min) * rel, true) end
            AddConn(bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true fromX(input.Position.X) end end))
