function Library:CreateColorPicker(opts)
    local c = ElementBase(self.Self.Theme, self.Page, 40)
    local color = opts.Default or Color3.fromRGB(255, 255, 255)
    local flag = opts.Flag

    Create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Name or "Color",
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = c,
    })

    local preview = Create("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -54, 0.5, -10),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = c,
    })
    Round(preview, 4)
    Stroke(preview, self.Self.Theme.Stroke, 1)

    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = c,
    })
    btn.MouseButton1Click:Connect(function()
        local pickerGui = Create("ScreenGui", { Parent = CoreGui, Name = "RvUiColorPicker", ResetOnSpawn = false })
        local picker = Create("Frame", {
            Size = UDim2.new(0, 220, 0, 220),
            Position = UDim2.new(0.5, -110, 0.5, -110),
            BackgroundColor3 = self.Self.Theme.Background,
            BorderSizePixel = 0,
            Parent = pickerGui,
            Active = true,
        })
        Round(picker, 8)
        Stroke(picker, self.Self.Theme.Stroke, 1.5)
        MakeDraggable(picker, picker)

        local hue = Create("Frame", {
            Size = UDim2.new(0, 180, 0, 20),
            Position = UDim2.new(0, 20, 0, 20),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Parent = picker,
        })
        Round(hue, 4)

        local r, g, b = color.R * 255, color.G * 255, color.B * 255

        local function makeSlider(name, y, val, cb)
            Create("TextLabel", {
                Size = UDim2.new(0, 30, 0, 16),
                Position = UDim2.new(0, 20, 0, y),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = name,
                TextColor3 = self.Self.Theme.Text,
                TextSize = 12,
                Parent = picker,
            })
            local bar = Create("TextButton", {
                Size = UDim2.new(0, 150, 0, 12),
                Position = UDim2.new(0, 50, 0, y + 2),
                BackgroundColor3 = self.Self.Theme.Secondary,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Parent = picker,
            })
            Round(bar, 6)
            local fill = Create("Frame", {
                Size = UDim2.new(val / 255, 0, 1, 0),
                BackgroundColor3 = self.Self.Theme.Accent,
                BorderSizePixel = 0,
                Parent = bar,
            })
            Round(fill, 6)
            local dragging = false
            local function upd(input)
                local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local v = math.floor(rel * 255)
                fill.Size = UDim2.new(rel, 0, 1, 0)
                cb(v)
            end
            bar.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    upd(i)
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
                    upd(i)
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

        local function updateColor()
            color = Color3.fromRGB(r, g, b)
            hue.BackgroundColor3 = color
            preview.BackgroundColor3 = color
            if flag then self.Self.Flags[flag] = { R = r, G = g, B = b } end
            if opts.Callback then pcall(opts.Callback, color) end
        end

        makeSlider("R", 60, r, function(v) r = v; updateColor() end)
        makeSlider("G", 90, g, function(v) g = v; updateColor() end)
        makeSlider("B", 120, b, function(v) b = v; updateColor() end)

        local close = Create("TextButton", {
            Size = UDim2.new(1, -40, 0, 28),
            Position = UDim2.new(0, 20, 1, -40),
            BackgroundColor3 = self.Self.Theme.Accent,
            BorderSizePixel = 0,
            Font = Enum.Font.GothamBold,
            Text = "Done",
            TextColor3 = self.Self.Theme.Background,
            TextSize = 13,
            AutoButtonColor = false,
            Parent = picker,
        })
        Round(close, 5)
        close.MouseButton1Click:Connect(function() pickerGui:Destroy() end)

        if flag then
            self.Self.Flags[flag] = { R = r, G = g, B = b }
        end
    end)

    if flag then
        self.Self.Flags[flag] = { R = color.R * 255, G = color.G * 255, B = color.B * 255 }
        self.Self.Options[flag] = { SetValue = function(_, v)
            if type(v) == "table" then
                color = Color3.fromRGB(v.R or 255, v.G or 255, v.B or 255)
                preview.BackgroundColor3 = color
            end
        end }
    end
    return c
end

local function FinalizePending(pending)
    if not pending or not pending._pending then return pending end
    local keyGui = pending.keyGui
    local self = pending.self
    local gui = pending.gui
    local done = false
    keyGui.Destroying:Connect(function() done = true end)
    task.spawn(function()
        while keyGui and keyGui.Parent and not done do
            task.wait(0.1)
        end
        self:_BuildMain(gui, self.WindowTitle, Enum.KeyCode.RightShift)
    end)
    return pending
end

local originalCreateWindow = Library.CreateWindow
function Library:CreateWindow(opts)
    local result = originalCreateWindow(self, opts)
    if result and result._pending then
        return FinalizePending(result)
    end
    return result
end

return Library
