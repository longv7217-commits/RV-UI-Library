            local current = default local listening = false local o = {} o.Instance = holder o.Value = current o.Type = "Keybind"
            AddConn(UserInputService.InputBegan:Connect(function(input, gp) if gp then return end if listening and input.UserInputType == Enum.UserInputType.Keyboard then if input.KeyCode == Enum.KeyCode.Escape then listening = false keyBtn.Text = current and current.Name or "None" return end current = input.KeyCode o.Value = current keyBtn.Text = current.Name listening = false SafeCallback(callback, current) return end if not listening and current and input.KeyCode == current then SafeCallback(callback, current) end end))
            AddConn(keyBtn.MouseButton1Click:Connect(function() if listening then return end listening = true keyBtn.Text = "..." end))
            function o:Set(k, fire) current = k o.Value = k keyBtn.Text = k and k.Name or "None" if fire ~= false then SafeCallback(callback, k) end end
            function o:Get() return current end function o:Destroy() holder:Destroy() end function o:RefreshTheme(nt) th2 = nt holder.BackgroundColor3 = nt.Panel lbl.TextColor3 = nt.Text keyBtn.BackgroundColor3 = nt.PanelLight keyBtn.TextColor3 = nt.Text end function o:RefreshAccent(c) end
            table.insert(Tab.Controls, o) table.insert(Window.Controls, o) return o
        end
        function Tab:CreateThemePicker(name, callback)
            local names = {} for k, _ in pairs(Library.Themes) do table.insert(names, k) end table.sort(names)
            local dd = Tab:CreateDropdown(name or "Theme", names, Library.ThemeName, function(v) Window:SetTheme(v) SafeCallback(callback, v) end)
