function Library:Notify(opts)
    opts = opts or {}
    local holder = GetNotifHolder()
    if not holder then return end

    local frame = Create("Frame", {
        Size = UDim2.new(0, 300, 0, 80),
        Position = UDim2.new(1, 320, 1, -20 - (#holder:GetChildren() * 90)),
        BackgroundColor3 = self.Theme.Secondary,
        BorderSizePixel = 0,
        Parent = holder,
    })
    Round(frame, 8)
    Stroke(frame, self.Theme.Stroke)

    local accentBar = Create("Frame", {
        Size = UDim2.new(0, 4, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        Parent = frame,
    })
    Round(accentBar, 2)

    Create("TextLabel", {
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.new(0, 20, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = opts.Title or "Notification",
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -30, 1, -35),
        Position = UDim2.new(0, 20, 0, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Content or "",
        TextColor3 = self.Theme.TextDim,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = frame,
    })

    Tween(frame, 0.3, {Position = UDim2.new(1, -320, 1, -20 - (#holder:GetChildren() - 1) * 90)})

    task.delay(opts.Duration or 5, function()
        if frame and frame.Parent then
            Tween(frame, 0.3, {Position = UDim2.new(1, 320, frame.Position.Y.Scale, frame.Position.Y.Offset)})
            task.wait(0.3)
            frame:Destroy()
        end
    end)
end

function Library:SaveConfig(name)
    name = name or self.CurrentConfig
    if not isfolder or not writefile then
        self:Notify({Title = "Config", Content = "Exploit does not support file saving."})
        return
    end
    if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
    local data = HttpService:JSONEncode(self.Flags)
    writefile(self.ConfigFolder .. "/" .. name .. ".json", data)
    self:Notify({Title = "Config Saved", Content = "Saved as: " .. name})
end

function Library:LoadConfig(name)
    name = name or self.CurrentConfig
    if not isfile then return end
    local path = self.ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then
        self:Notify({Title = "Config", Content = "Config not found: " .. name})
        return
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok then
        self:Notify({Title = "Config", Content = "Failed to load config."})
        return
    end
    for flag, value in pairs(data) do
        self.Flags[flag] = value
        if self.Options[flag] then
            pcall(function() self.Options[flag]:SetValue(value) end)
        end
    end
    self:Notify({Title = "Config Loaded", Content = "Loaded: " .. name})
end

function Library:ListConfigs()
    if not listfiles or not isfolder(self.ConfigFolder) then return {} end
    local list = {}
    for _, f in pairs(listfiles(self.ConfigFolder)) do
        local n = f:match("([^/\\]+)%.json$")
        if n then table.insert(list, n) end
    end
    return list
end

local function MakeDraggable(frame, dragArea)
    dragArea = dragArea or frame
    local dragging, dragStart, startPos

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                UserInputService.MouseIconEnabled = true
                pcall(function()
                end)
            end
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                end
            end)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging then
            local delta = UserInputService:GetMouseLocation() - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
            local vp = workspace.CurrentCamera.ViewportSize
            local minX = -frame.AbsoluteSize.X + 60
            local maxX = vp.X - 60
            local minY = 36
            local maxY = vp.Y - 40
            local nx = math.clamp(newPos.X.Offset, minX, maxX)
            local ny = math.clamp(newPos.Y.Offset, minY, maxY)
            frame.Position = UDim2.new(0, nx, 0, ny)
        end
    end)

    dragArea.MouseEnter:Connect(function()
    end)
end

