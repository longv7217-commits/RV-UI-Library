local function FlagsToSave()
    local out = {}
    for k, v in pairs(Library.Flags) do
        if type(v) == "number" or type(v) == "string" or type(v) == "boolean" then out[k] = v end
        if typeof(v) == "Color3" then out[k] = ColorToHex(v) end
        if typeof(v) == "EnumItem" then out[k] = v.Name end
        if type(v) == "table" then
            local arr = {}
            local isArr = true
            for kk, vv in pairs(v) do if type(kk) ~= "number" then isArr = false end end
            if isArr then for _, vv in ipairs(v) do if type(vv) == "string" or type(vv) == "number" then table.insert(arr, vv) end end out[k] = arr end
        end
    end
    return out
end
function Library:SaveConfig(name)
    local cfgName = name or "default"
    local data = FlagsToSave()
    data._theme = Library.CurrentThemeName
    data._version = Library.Version
    local json = SafeJSONEncode(data)
    if writefile then
        local ok = pcall(function()
            if not isfolder("WindLibrary") then makefolder("WindLibrary") end
            writefile("WindLibrary/" .. cfgName .. ".json", json)
        end)
        return ok
    end
    return false
end
function Library:LoadConfig(name)
    local cfgName = name or "default"
    if readfile and isfile and isfile("WindLibrary/" .. cfgName .. ".json") then
        local ok, content = pcall(function() return readfile("WindLibrary/" .. cfgName .. ".json") end)
        if ok and content then
            local data = SafeJSONDecode(content)
            for k, v in pairs(data) do
                if k ~= "_theme" and k ~= "_version" then
                    if Library.FlagCallbacks[k] then SafeCall(Library.FlagCallbacks[k], v) end
                    Library.Flags[k] = v
                end
            end
            if data._theme and Library.Themes[data._theme] then
                for _, w in ipairs(Library.Windows) do if w.SetTheme then w:SetTheme(data._theme) end end
            end
            return data
        end
    end
    return nil
end
function Library:ListConfigs()
    if listfiles and isfolder("WindLibrary") then
        local files = listfiles("WindLibrary")
        local out = {}
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
        return out
    end
    return {}
end
function Library:DeleteConfig(name)
    if delfile and isfile("WindLibrary/" .. name .. ".json") then
        local ok = pcall(function() delfile("WindLibrary/" .. name .. ".json") end)
        return ok
    end
    return false
end
