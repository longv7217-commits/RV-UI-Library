        BackgroundColor3 = self.Self.Theme.Secondary,
        BorderSizePixel = 0,
        Font = Enum.Font.Gotham,
        Text = "  " .. tostring(current),
        TextColor3 = self.Self.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = container,
    })
    Round(header, 5)
    Stroke(header, self.Self.Theme.Stroke)

    Create("TextLabel", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -24, 0.5, -10),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "v",
        TextColor3 = self.Self.Theme.TextDim,
        TextSize = 12,
        Parent = header,
    })

    local list = Create("ScrollingFrame", {
        Size = UDim2.new(1, -24, 0, 0),
        Position = UDim2.new(0, 12, 0, 58),
        BackgroundColor3 = self.Self.Theme.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self.Self.Theme.Accent,
        Visible = false,
        ZIndex = 5,
        Parent = container,
    })
    Round(list, 5)
    Stroke(list, self.Self.Theme.Stroke)
    Create("UIListLayout", {Padding = UDim.new(0, 2), Parent = list})
    Create("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = list})

    local function rebuild()
        for _, c in pairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, opt in ipairs(options) do
            local o = Create("TextButton", {
                Size = UDim2.new(1, -4, 0, 24),
                BackgroundColor3 = self.Self.Theme.Secondary,
                BorderSizePixel = 0,
                Font = Enum.Font.Gotham,
                Text = "  " .. tostring(opt),
                TextColor3 = self.Self.Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = list,
                LayoutOrder = i,
            })
            Round(o, 4)
            o.MouseButton1Click:Connect(function()
                current = opt
                header.Text = "  " .. tostring(opt)
                if flag then self.Self.Flags[flag] = opt end
                if opts.Callback then
                    local ok, err = pcall(opts.Callback, opt)
                    if not ok then warn("[RvUi] Dropdown callback:", err) end
                end
                expanded = false
                list.Visible = false
                Tween(list, 0.15, {Size = UDim2.new(1, -24, 0, 0)})
                container.Size = UDim2.new(1, 0, 0, 64)
            end)
        end
        list.CanvasSize = UDim2.new(0, 0, 0, #options * 26 + 8)
    end
    rebuild()

    header.MouseButton1Click:Connect(function()
        expanded = not expanded
        if expanded then
            local h = math.min(#options * 26 + 8, 120)
            list.Visible = true
            container.Size = UDim2.new(1, 0, 0, 64 + h)
            Tween(list, 0.15, {Size = UDim2.new(1, -24, 0, h)})
        else
            Tween(list, 0.15, {Size = UDim2.new(1, -24, 0, 0)})
            task.wait(0.15)
            list.Visible = false
            container.Size = UDim2.new(1, 0, 0, 64)
        end
    end)

    if flag then
        self.Self.Flags[flag] = current
        self.Self.Options[flag] = {SetValue = function(_, v)
            current = v
            header.Text = "  " .. tostring(v)
        end}
    end
    return container
end

