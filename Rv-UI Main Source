local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {}
Library.__index = Library

local CONFIG = {
    Title      = "ComBat G-U-I",
    Subtitle   = "combat gui for combat (yes it is)",
    Version    = "v1.0.0",
    Credit     = "by Realvux",
    Keybind    = Enum.KeyCode.K,
    Accent     = Color3.fromRGB(255, 255, 255),
    Background = Color3.fromRGB(12, 12, 12),
    Panel      = Color3.fromRGB(20, 20, 20),
    PanelLight = Color3.fromRGB(28, 28, 28),
    Stroke     = Color3.fromRGB(45, 45, 45),
    Text       = Color3.fromRGB(255, 255, 255),
    SubText    = Color3.fromRGB(170, 170, 170),
    Font       = Enum.Font.GothamMedium,
    FontBold   = Enum.Font.GothamBold,
}

-- ===== Helpers =====
local function newInst(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

local function addStroke(parent, color, thickness, transparency)
    return newInst("UIStroke", {
        Parent = parent,
        Color = color or CONFIG.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function addCorner(parent, radius)
    return newInst("UICorner", {
        Parent = parent,
        CornerRadius = UDim.new(0, radius or 8),
    })
end

-- ===== Window =====
local Window = {}
Window.__index = Window

function Library:Window(opts)
    opts = opts or {}
    for k, v in pairs(opts) do
        CONFIG[k] = v
    end

    local old = CoreGui:FindFirstChild("CombatGui")
    if old then old:Destroy() end

    local ScreenGui = newInst("ScreenGui", {
        Name = "CombatGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    ScreenGui.Parent = CoreGui

    local Main = newInst("Frame", {
        Parent = ScreenGui,
        Size = UDim2.new(0, 560, 0, 380),
        Position = UDim2.new(0.5, -280, 0.5, -190),
        BackgroundColor3 = CONFIG.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
        Draggable = true,
    })
    addCorner(Main, 12)
    addStroke(Main, CONFIG.Stroke, 1.5)

    local TopBar = newInst("Frame", {
        Parent = Main,
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
    })
    addCorner(TopBar, 12)
    newInst("Frame", {
        Parent = TopBar,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
    })

    local LogoDot = newInst("Frame", {
        Parent = TopBar,
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 16, 0.5, -6),
        BackgroundColor3 = CONFIG.Accent,
        BorderSizePixel = 0,
    })
    addCorner(LogoDot, 6)

    newInst("TextLabel", {
        Parent = TopBar,
        Size = UDim2.new(0, 300, 0, 20),
        Position = UDim2.new(0, 38, 0, 5),
        BackgroundTransparency = 1,
        Text = CONFIG.Title .. "  " .. CONFIG.Version,
        TextColor3 = CONFIG.Text,
        Font = CONFIG.FontBold,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    newInst("TextLabel", {
        Parent = TopBar,
        Size = UDim2.new(0, 300, 0, 14),
        Position = UDim2.new(0, 38, 0, 23),
        BackgroundTransparency = 1,
        Text = CONFIG.Subtitle .. "  •  " .. CONFIG.Credit,
        TextColor3 = CONFIG.SubText,
        Font = CONFIG.Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local CloseBtn = newInst("TextButton", {
        Parent = TopBar,
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(1, -36, 0.5, -14),
        BackgroundColor3 = CONFIG.PanelLight,
        BorderSizePixel = 0,
        Text = "X",
        TextColor3 = CONFIG.Text,
        Font = CONFIG.FontBold,
        TextSize = 14,
        AutoButtonColor = false,
    })
    addCorner(CloseBtn, 6)

    local TabBar = newInst("Frame", {
        Parent = Main,
        Size = UDim2.new(0, 140, 1, -42),
        Position = UDim2.new(0, 0, 0, 42),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
    })

    local Content = newInst("Frame", {
        Parent = Main,
        Size = UDim2.new(1, -140, 1, -42),
        Position = UDim2.new(0, 140, 0, 42),
        BackgroundColor3 = CONFIG.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })

    local self = setmetatable({
        ScreenGui = ScreenGui,
        Main = Main,
        TabBar = TabBar,
        Content = Content,
        Tabs = {},
        TabCount = 0,
        Hidden = false,
    }, Window)

    -- Close button
    CloseBtn.MouseButton1Click:Connect(function()
        self.Hidden = true
        Main.Visible = false
    end)

    -- Keybind toggle
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == CONFIG.Keybind then
            self.Hidden = not self.Hidden
            Main.Visible = not self.Hidden
        end
    end)

    -- Mini toggle
    local MiniToggle = newInst("TextButton", {
        Parent = ScreenGui,
        Size = UDim2.new(0, 36, 0, 36),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
        Text = "≡",
        TextColor3 = CONFIG.Text,
        Font = CONFIG.FontBold,
        TextSize = 16,
        AutoButtonColor = false,
        Active = true,
        Draggable = true,
    })
    addCorner(MiniToggle, 8)
    addStroke(MiniToggle, CONFIG.Stroke, 1)

    MiniToggle.MouseButton1Click:Connect(function()
        self.Hidden = not self.Hidden
        Main.Visible = not self.Hidden
    end)

    self.MiniToggle = MiniToggle
    return self
end

function Window:Tab(name)
    self.TabCount = self.TabCount + 1
    local order = self.TabCount

    local btn = newInst("TextButton", {
        Parent = self.TabBar,
        Size = UDim2.new(1, -16, 0, 34),
        Position = UDim2.new(0, 8, 0, 8 + (order - 1) * 40),
        BackgroundColor3 = CONFIG.PanelLight,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = CONFIG.SubText,
        Font = CONFIG.Font,
        TextSize = 13,
        AutoButtonColor = false,
    })
    addCorner(btn, 6)

    local page = newInst("ScrollingFrame", {
        Parent = self.Content,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = CONFIG.Stroke,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = (order == 1),
    })

    newInst("UIPadding", {
        Parent = page,
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 12),
    })

    newInst("UIListLayout", {
        Parent = page,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    btn.MouseButton1Click:Connect(function()
        for _, other in ipairs(self.TabBar:GetChildren()) do
            if other:IsA("TextButton") then
                other.BackgroundColor3 = CONFIG.PanelLight
                other.TextColor3 = CONFIG.SubText
            end
        end
        btn.BackgroundColor3 = CONFIG.Accent
        btn.TextColor3 = CONFIG.Background
        for _, other in ipairs(self.Content:GetChildren()) do
            if other:IsA("ScrollingFrame") then
                other.Visible = false
            end
        end
        page.Visible = true
    end)

    if order == 1 then
        btn.BackgroundColor3 = CONFIG.Accent
        btn.TextColor3 = CONFIG.Background
    end

    local tabObj = setmetatable({
        Page = page,
        Window = self,
    }, { __index = Window })

    self.Tabs[name] = tabObj
    return tabObj
end

-- ===== Tab elements =====
function Window:Toggle(name, default, callback)
    local parent = self.Page

    local holder = newInst("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
    })
    addCorner(holder, 8)
    addStroke(holder, CONFIG.Stroke, 1)

    newInst("TextLabel", {
        Parent = holder,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = CONFIG.Text,
        Font = CONFIG.Font,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local swBg = newInst("Frame", {
        Parent = holder,
        Size = UDim2.new(0, 46, 0, 24),
        Position = UDim2.new(1, -60, 0.5, -12),
        BackgroundColor3 = default and CONFIG.Accent or CONFIG.Stroke,
        BorderSizePixel = 0,
    })
    addCorner(swBg, 12)

    local knob = newInst("Frame", {
        Parent = swBg,
        Size = UDim2.new(0, 18, 0, 18),
        Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = default and CONFIG.Background or CONFIG.Text,
        BorderSizePixel = 0,
    })
    addCorner(knob, 9)

    local btn = newInst("TextButton", {
        Parent = holder,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
    })

    local state = default
    local api = {
        Holder = holder,
        Set = function(_, v)
            if v == state then return end
            state = v
            TweenService:Create(swBg, TweenInfo.new(0.18), {
                BackgroundColor3 = state and CONFIG.Accent or CONFIG.Stroke,
            }):Play()
            TweenService:Create(knob, TweenInfo.new(0.18), {
                Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                BackgroundColor3 = state and CONFIG.Background or CONFIG.Text,
            }):Play()
            if callback then callback(state) end
        end,
        Get = function()
            return state
        end,
        SetVisible = function(_, visible)
            holder.Visible = visible
            holder.Size = visible and UDim2.new(1, 0, 0, 44) or UDim2.new(1, 0, 0, 0)
        end,
    }

    btn.MouseButton1Click:Connect(function()
        api:Set(not state)
    end)

    return api
end

function Window:Input(name, default, callback)
    local parent = self.Page

    local holder = newInst("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
    })
    addCorner(holder, 8)
    addStroke(holder, CONFIG.Stroke, 1)

    newInst("TextLabel", {
        Parent = holder,
        Size = UDim2.new(0, 220, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = CONFIG.Text,
        Font = CONFIG.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local box = newInst("TextBox", {
        Parent = holder,
        Size = UDim2.new(0, 110, 0, 28),
        Position = UDim2.new(1, -124, 0.5, -14),
        BackgroundColor3 = CONFIG.PanelLight,
        BorderSizePixel = 0,
        Text = tostring(default),
        TextColor3 = CONFIG.Text,
        Font = CONFIG.Font,
        TextSize = 12,
        PlaceholderText = "value",
        PlaceholderColor3 = CONFIG.SubText,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    addCorner(box, 6)
    addStroke(box, CONFIG.Stroke, 1)

    box.Focused:Connect(function()
        TweenService:Create(box, TweenInfo.new(0.15), {
            BackgroundColor3 = CONFIG.Accent,
        }):Play()
        box.TextColor3 = CONFIG.Background
    end)

    box.FocusLost:Connect(function()
        TweenService:Create(box, TweenInfo.new(0.15), {
            BackgroundColor3 = CONFIG.PanelLight,
        }):Play()
        box.TextColor3 = CONFIG.Text
        if callback then callback(box.Text) end
    end)

    return {
        Holder = holder,
        TextBox = box,
        Set = function(_, text)
            box.Text = tostring(text)
        end,
        Get = function()
            return box.Text
        end,
        SetVisible = function(_, visible)
            holder.Visible = visible
            holder.Size = visible and UDim2.new(1, 0, 0, 44) or UDim2.new(1, 0, 0, 0)
        end,
    }
end

function Window:Button(name, callback)
    local parent = self.Page

    local btn = newInst("TextButton", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = CONFIG.Text,
        Font = CONFIG.Font,
        TextSize = 13,
        AutoButtonColor = false,
    })
    addCorner(btn, 8)
    addStroke(btn, CONFIG.Stroke, 1)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = CONFIG.PanelLight,
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = CONFIG.Panel,
        }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)

    return {
        Button = btn,
        SetVisible = function(_, visible)
            btn.Visible = visible
            btn.Size = visible and UDim2.new(1, 0, 0, 40) or UDim2.new(1, 0, 0, 0)
        end,
    }
end

function Window:Label(text)
    local parent = self.Page
    local label = newInst("TextLabel", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = CONFIG.Panel,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = CONFIG.SubText,
        Font = CONFIG.Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    addCorner(label, 6)
    addStroke(label, CONFIG.Stroke, 1)

    return {
        Label = label,
        Set = function(_, t)
            label.Text = t
        end,
        SetVisible = function(_, visible)
            label.Visible = visible
            label.Size = visible and UDim2.new(1, 0, 0, 28) or UDim2.new(1, 0, 0, 0)
        end,
    }
end

return Library
