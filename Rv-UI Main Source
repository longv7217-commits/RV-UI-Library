        mainStroke.Color = color
        for _, tab in pairs(self.Tabs) do
            if tab._btn then
                if tab._active then
                    tab._btn.BackgroundColor3 = color
                end
            end
            if tab._updateAccent then tab._updateAccent(color) end
        end
    end

