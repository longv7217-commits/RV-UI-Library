        newInst("UIListLayout", {
            Parent = page,
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })

        local Tab = {}
        Tab._btn = btn
        Tab._page = page
        Tab._active = false
        Tab.Theme = theme

        local function activate()
            for _, t in pairs(Window.Tabs) do
                t._active = false
                tween(t._btn, { BackgroundColor3 = theme.PanelLight, TextColor3 = theme.SubText }, 0.18)
                t._page.Visible = false
            end
            Tab._active = true
            tween(btn, { BackgroundColor3 = theme.Accent, TextColor3 = theme.Background }, 0.18)
            page.Visible = true
            page.Position = UDim2.new(0, 10, 0, 0)
            tween(page, { Position = UDim2.new(0, 0, 0, 0) }, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        end

        btn.MouseButton1Click:Connect(function()
            ripple(btn, theme.Accent)
            activate()
        end)
        btn.MouseEnter:Connect(function()
            if not Tab._active then
                tween(btn, { BackgroundColor3 = Color3.fromRGB(38, 38, 38) }, 0.15)
            end
        end)
        btn.MouseLeave:Connect(function()
            if not Tab._active then
                tween(btn, { BackgroundColor3 = theme.PanelLight }, 0.15)
            end
        end)

        function Tab:_updateAccent(color)
            if self._active then
                self._btn.BackgroundColor3 = color
            end
        end

        if self._tabCount == 1 then
            activate()
        end

