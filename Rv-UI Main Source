local function NewInst(class, props, parent)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            local ok = pcall(function() inst[k] = v end)
            if not ok and k ~= "Parent" then end
        end
    end
    if inst:IsA("GuiObject") then inst.Active = true inst.Draggable = false end
    if inst:IsA("TextButton") or inst:IsA("ImageButton") then
        local baseBg = inst.BackgroundColor3
        pcall(function()
            inst.MouseEnter:Connect(function()
                if inst.BackgroundTransparency >= 0.99 then return end
                local tw = TweenService:Create(inst, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.new(math.min(baseBg.R + 0.07, 1), math.min(baseBg.G + 0.07, 1), math.min(baseBg.B + 0.07, 1))})
                tw:Play()
            end)
            inst.MouseLeave:Connect(function()
                local tw = TweenService:Create(inst, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = baseBg})
                tw:Play()
            end)
        end)
    end
    if parent then inst.Parent = parent end
    return inst
end
local function Corner(parent, r)
    return NewInst("UICorner", {Parent = parent, CornerRadius = UDim.new(0, 0)})
end
local function Stroke(parent, color, thick, trans)
    return NewInst("UIStroke", {Parent = parent, Color = color or Library.CurrentTheme.Stroke, Thickness = thick or 1, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end
local function Padding(parent, t, l, r, b)
    return NewInst("UIPadding", {Parent = parent, PaddingTop = UDim.new(0, t or 0), PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0)})
end
local function Tween(inst, props, time, style, dir)
    local info = TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(inst, info, props)
    tw:Play()
    return tw
end
local function SafeCallback(cb, ...)
    if type(cb) == "function" then
        local ok, err = pcall(cb, ...)
        if not ok then warn(err) end
    end
end
local function Ripple(button, color)
    if not button or not button.Parent then return end
    local r = NewInst("Frame", {Parent = button, AnchorPoint = Vector2.new(0.5,0.5), BackgroundColor3 = color or Library.CurrentTheme.Accent, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.new(0,0,0,0), Position = UDim2.new(0.5,0,0.5,0), ZIndex = 50, ClipsDescendants = false})
    Corner(r, 100)
    local sz = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.2
    Tween(r, {Size = UDim2.new(0, sz, 0, sz), BackgroundTransparency = 1}, 0.45)
    task.delay(0.5, function() if r then r:Destroy() end end)
end
local function GetGuiParent()
    if gethui then local ok, hui = pcall(gethui) if ok and hui then return hui end end
    return CoreGui
end
local function DestroyAllLibraryGuis()
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name == "LibraryGui" or v.Name == "LibraryNotifyGui" or v.Name == "LibraryPopupGui" then v:Destroy() end
    end
    if gethui then local ok, hui = pcall(gethui) if ok and hui then for _, v in ipairs(hui:GetChildren()) do if v.Name == "LibraryGui" or v.Name == "LibraryNotifyGui" or v.Name == "LibraryPopupGui" then v:Destroy() end end end end
    Library.Windows = {}
end










































function Library:TrackConnection(conn)
    table.insert(self.Connections, conn)
    return conn
end
function Library:DisconnectAll()
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    self.Connections = {}
end
function Library:Notify(title, content, duration, image)
    local parent = GetGuiParent()
    local old = parent:FindFirstChild("LibraryNotifyGui")
    local gui
    if old then gui = old else gui = NewInst("ScreenGui", {Name = "LibraryNotifyGui", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}) gui.Parent = parent end
    local holder = gui:FindFirstChild("Holder")
    if not holder then holder = NewInst("Frame", {Name = "Holder", Parent = gui, Size = UDim2.new(0, 340, 1, 0), Position = UDim2.new(1, -350, 0, 10), BackgroundTransparency = 1, BorderSizePixel = 0}) NewInst("UIListLayout", {Parent = holder, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top}) end
    local th = self.CurrentTheme
    local card = NewInst("Frame", {Parent = holder, Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = th.Panel, BorderSizePixel = 0, ClipsDescendants = true})
    Corner(card, 10) Stroke(card, th.Stroke, 1)
    local bar = NewInst("Frame", {Parent = card, Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = th.Accent, BorderSizePixel = 0})
    local t1 = NewInst("TextLabel", {Parent = card, Size = UDim2.new(1, -24, 0, 20), Position = UDim2.new(0, 16, 0, 8), BackgroundTransparency = 1, Text = title or "Notification", TextColor3 = th.Text, Font = th.FontBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
    local t2 = NewInst("TextLabel", {Parent = card, Size = UDim2.new(1, -24, 0, 28), Position = UDim2.new(0, 16, 0, 28), BackgroundTransparency = 1, Text = content or "", TextColor3 = th.SubText, Font = th.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true})
    card.Position = UDim2.new(0, 360, 0, 0)
    Tween(card, {Position = UDim2.new(0, 0, 0, 0)}, 0.3, Enum.EasingStyle.Back)
    task.delay(duration or 3, function() if card then Tween(card, {Position = UDim2.new(0, 360, 0, 0)}, 0.25) task.delay(0.26, function() if card then card:Destroy() end end) end end)
    return card
end
function Library:CreateWindow(opts)
    opts = opts or {}
    DestroyAllLibraryGuis()
    local themeName = opts.Theme or opts.ThemeName or "Default"
    local th = Library.Themes[themeName] or Library.Themes["Default"]
    if opts.Accent then th = table.clone(th) th.Accent = opts.Accent end
    if opts.ThemeColor then th = table.clone(th) th.Accent = opts.ThemeColor end
    self.CurrentTheme = th
    self.ThemeName = th.Name
    local guiParent = GetGuiParent()
    local ScreenGui = NewInst("ScreenGui", {Name = "LibraryGui", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
    ScreenGui.Parent = guiParent
    local PopupGui = NewInst("ScreenGui", {Name = "LibraryPopupGui", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 500, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
