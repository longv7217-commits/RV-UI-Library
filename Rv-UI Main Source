    Window.Controls = {}
    Window._tabCount = 0
    Window._isMinimized = false
    Window._isHidden = false
    Window._dragging = false
    Window.SavedSize = Main.Size
    Window.SavedPosition = Main.Position
    Window.FloatButton = FloatButton
    Window.MiniBar = MiniBar
    Window._dragStart = Vector2.new(0,0)
    Window._startPos = Main.Position
    Window._conns = {}
    local function AddConn(c) table.insert(Window._conns, c) table.insert(Library.Connections, c) return c end
    local function SetMinimized(v)
        Window._isMinimized = v
        if v then Main.Visible = false MiniBar.Visible = true else Main.Visible = true MiniBar.Visible = false end
        if v then Tween(MiniBar, {Size = UDim2.new(0, 56, 0, 56)}, 0.2) end
    end
    local function SetHidden(v)
        Window._isHidden = v
        Main.Visible = not v
        if not v then MiniBar.Visible = Window._isMinimized end
        if v then MiniBar.Visible = false end
    end
    AddConn(MinBtn.MouseButton1Click:Connect(function() Ripple(MinBtn, th.Accent) SetMinimized(true) end))
    AddConn(CloseBtn.MouseButton1Click:Connect(function() Ripple(CloseBtn, th.Accent) SetMinimized(true) end))
    AddConn(CloseBtn.MouseEnter:Connect(function() Tween(CloseBtn, {BackgroundColor3 = Color3.fromRGB(210,60,60)}, 0.15) end))
    AddConn(CloseBtn.MouseLeave:Connect(function() Tween(CloseBtn, {BackgroundColor3 = th.PanelLight}, 0.15) end))
    AddConn(MinBtn.MouseEnter:Connect(function() Tween(MinBtn, {BackgroundColor3 = th.Accent}, 0.15) end))
    AddConn(MinBtn.MouseLeave:Connect(function() Tween(MinBtn, {BackgroundColor3 = th.PanelLight}, 0.15) end))
    local dragInput = nil
    local ActiveDragKind = nil
    local function IsPointInGui(gui, point)
        if not gui then return false end
        local ap = gui.AbsolutePosition
        local asz = gui.AbsoluteSize
        return point.X >= ap.X and point.X <= ap.X + asz.X and point.Y >= ap.Y and point.Y <= ap.Y + asz.Y
    end
    local function IsOverInteractive(parent, point)
        for _, d in ipairs(parent:GetDescendants()) do
            if d:IsA("TextButton") or d:IsA("ImageButton") or d:IsA("TextBox") then
                if IsPointInGui(d, point) then return true end
            end
        end
        return false
    end
    local dragLastPos = Vector2.new(0, 0)
    local dragTotalMoved = 0
    local function BeginDrag(kind, input)
        if ActiveDragKind ~= nil then return false end
        ActiveDragKind = kind
        Window._dragging = true
        dragInput = input
        dragLastPos = input.Position
        dragTotalMoved = 0
        return true
    end
    local function EndDrag()
        Window._dragging = false
        Window._miniDragging = false
        dragInput = nil
        ActiveDragKind = nil
    end
    AddConn(TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if IsOverInteractive(TopBar, input.Position) then return end
            BeginDrag("main", input)
        end
    end))
    AddConn(MiniBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if Window._isMinimized then Window._miniDragging = true end
            BeginDrag("float", input)
        end
    end))
    AddConn(UserInputService.InputChanged:Connect(function(input)
        if not Window._dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragLastPos
        dragLastPos = input.Position
        dragTotalMoved = dragTotalMoved + math.abs(delta.X) + math.abs(delta.Y)
        local cam = workspace.CurrentCamera
        local vw = cam and cam.ViewportSize.X or 1280
        local vh = cam and cam.ViewportSize.Y or 720
        if ActiveDragKind == "float" and Window._isMinimized then
            local cur = MiniBar.AbsolutePosition
            local nx = math.clamp(cur.X + delta.X, 0, vw - 56)
            local ny = math.clamp(cur.Y + delta.Y, 0, vh - 56)
            MiniBar.Position = UDim2.new(0, nx, 0, ny)
        else
            local cur = Main.AbsolutePosition
            local nx = math.clamp(cur.X + delta.X, -Main.AbsoluteSize.X + 80, vw - 80)
            local ny = math.clamp(cur.Y + delta.Y, 0, vh - 40)
            Main.Position = UDim2.new(0, nx, 0, ny)
            if Window then Window.SavedPosition = Main.Position end
        end
    end))
    AddConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local wasFloat = ActiveDragKind == "float"
        local moved = dragTotalMoved
        EndDrag()
        if wasFloat and moved < 6 and Window._isMinimized then SetMinimized(false) end
    end))
    local ResizeHandle = NewInst("TextButton", {Parent = Main, Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(1, -36, 1, -36), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Active = true, Draggable = false, ZIndex = 60})
    local HandLabel = NewInst("TextLabel", {Parent = ResizeHandle, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "✋", TextColor3 = Color3.fromRGB(255, 255, 255), Font = th.FontBold, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 61})
    local ResizeDragging = false
    local ResizeStartPos = Vector2.new(0, 0)
    local ResizeStartSize = Main.Size
    AddConn(ResizeHandle.InputBegan:Connect(function(input)
        if ActiveDragKind ~= nil then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ActiveDragKind = "resize"
            ResizeDragging = true
            ResizeStartPos = input.Position
            ResizeStartSize = Main.Size
            if Window then Window.SavedSize = Window.SavedSize or Main.Size Window.SavedPosition = Window.SavedPosition or Main.Position end
            HandLabel.Text = "✊"
            Tween(HandLabel, {TextSize = 24}, 0.12)
        end
    end))
    AddConn(UserInputService.InputChanged:Connect(function(input)
        if not ResizeDragging or ActiveDragKind ~= "resize" then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - ResizeStartPos
        local nw = math.clamp(ResizeStartSize.X.Offset + delta.X, 420, 980)
        local nh = math.clamp(ResizeStartSize.Y.Offset + delta.Y, 300, 720)
        Main.Size = UDim2.new(0, nw, 0, nh)
        if Window then Window.SavedSize = Main.Size end
    end))
    AddConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if ResizeDragging then
            ResizeDragging = false
            if ActiveDragKind == "resize" then ActiveDragKind = nil end
            HandLabel.Text = "✋"
            Tween(HandLabel, {TextSize = 22}, 0.12)
        end
    end))
    AddConn(ResizeHandle.MouseEnter:Connect(function() if not ResizeDragging then Tween(HandLabel, {TextSize = 24}, 0.12) end end))
    AddConn(ResizeHandle.MouseLeave:Connect(function() if not ResizeDragging then Tween(HandLabel, {TextSize = 22}, 0.12) end end))
    local keybind = opts.Keybind or opts.ToggleKey or Enum.KeyCode.RightShift
    Window.Keybind = keybind
    AddConn(UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == keybind then if Window._isMinimized then SetMinimized(false) elseif Window._isHidden then SetHidden(false) else SetMinimized(true) end end
    end))
