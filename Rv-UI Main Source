local Library = loadstring(game:HttpGet("https://your.url/library.lua"))()

local Window = Library:CreateWindow({
    Title = "My Combat GUI",
    Subtitle = "by you",
    Keybind = Enum.KeyCode.K,
    Theme = {
        Accent = Color3.fromRGB(255, 80, 80),
    },
})

Window:SetAccent(Color3.fromRGB(80, 200, 255))

local Tab = Window:CreateTab("Auto Block", "🛡")

Tab:CreateSection("Main")

Tab:CreateToggle("Enable", false, function(v)
    print("Toggle:", v)
end)

Tab:CreateSlider("Range", 0, 50, 15, function(v)
    print("Slider:", v)
end)

Tab:CreateInput("Speed", "16", function(v)
    print("Input:", v)
end, true)

Tab:CreateButton("Reset", function()
    print("Reset clicked")
end)

Tab:CreateDropdown("Mode", {"Fast", "Slow", "Custom"}, "Fast", function(v)
    print("Dropdown:", v)
end)

Tab:CreateColorPicker("Accent", Color3.fromRGB(255, 255, 255), function(c)
    Window:SetAccent(c)
end)

Tab:CreateKeybind("Toggle Key", Enum.KeyCode.K, function(k)
    Window:Toggle()
end)

Tab:CreateImage("rbxassetid://1234567890", 120)

Tab:CreateLabel("Hello world")
