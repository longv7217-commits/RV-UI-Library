        function Tab:CreateSlider(name, min, max, default, callback)
            min = min or 0
            max = max or 100
            default = default or min

            local holder = newInst("Frame", {
                Parent = page,
                Size = UDim2.new(1, 0, 0, 54),
                BackgroundColor3 = theme.Panel,
                BorderSizePixel = 0,
            })
            addCorner(holder, 8)
            addStroke(holder, theme.Stroke, 1)

            local label = newInst("TextLabel", {
                Parent = holder,
                Size = UDim2.new(1, -80, 0, 20),
                Position = UDim2.new(0, 14, 0, 6),
                BackgroundTransparency = 1,
                Text = name or "",
                TextColor3 = theme.Text,
                Font = theme.Font,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
            })

            local valLabel = newInst("TextLabel", {
                Parent = holder,
                Size = UDim2.new(0, 60, 0, 20),
                Position = UDim2.new(1, -74, 0, 6),
                BackgroundTransparency = 1,
                Text = tostring(default),
                TextColor3 = theme.Accent,
                Font = theme.FontBold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
            })

            local barBg = newInst("Frame", {
                Parent = holder,
                Size = UDim2.new(1, -28, 0, 6),
                Position = UDim2.new(0, 14, 0, 34),
                BackgroundColor3 = theme.PanelLight,
                BorderSizePixel = 0,
            })
            addCorner(barBg, 3)

            local fill = newInst("Frame", {
                Parent = barBg,
                Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
            })
            addCorner(fill, 3)

            local knob = newInst("Frame", {
                Parent = barBg,
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7),
                BackgroundColor3 = theme.Text,
                BorderSizePixel = 0,
                ZIndex = 2,
            })
            addCorner(knob, 7)

            local dragging = false

            local function updateFromX(x)
                local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                local val = min + (max - min) * rel
                val = math.floor(val * 100 + 0.5) / 100
                fill.Size = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, -7, 0.5, -7)
                valLabel.Text = tostring(val)
                if callback then
                    task.spawn(function() callback(val) end)
                end
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local obj = {}
            obj.Instance = holder
            obj.Value = default

            function obj:Set(v)
                v = math.clamp(v, min, max)
                obj.Value = v
                local rel = (v - min) / (max - min)
                fill.Size = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, -7, 0.5, -7)
                valLabel.Text = tostring(v)
                if callback then task.spawn(function() callback(v) end) end
            end
            function obj:Get() return obj.Value end
            function obj:SetText(t) label.Text = t end
            function obj:Destroy() holder:Destroy() end
            return obj
        end

