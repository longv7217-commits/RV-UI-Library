            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 14),
            Parent = page,
        })

        local tabObj = { Name = name, Button = btn, Page = page, Self = self.Self, _isTab = true }
        local tabMeta = {}
        tabMeta.__index = function(t, k)
            local creators = {
                "CreateButton","CreateToggle","CreateSlider","CreateInput",
                "CreateDropdown","CreateKeybind","CreateLabel","CreateSection","CreateColorPicker",
            }
            for _, cn in ipairs(creators) do
                if k == cn then return Library[cn] end
            end
            return rawget(t, k)
        end
        setmetatable(tabObj, tabMeta)

        btn.MouseButton1Click:Connect(function()
            self:SelectTab(tabObj)
        end)

        table.insert(self.Tabs, tabObj)
        if #self.Tabs == 1 then
            self:SelectTab(tabObj)
        end
        return tabObj
    end

