            local holder = NewInst("Frame", {Parent = page, Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = th2.Panel, BorderSizePixel = 0}) Corner(holder, 9) Stroke(holder, th2.Stroke, 1)
            local lbl = NewInst("TextLabel", {Parent = holder, Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(0, 14, 0, 0), BackgroundTransparency = 1, Text = name or "", TextColor3 = th2.Text, Font = th2.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left})
