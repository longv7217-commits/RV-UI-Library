            AddConn(UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end))
            function o:Set(v, fire) apply(v, fire) end function o:Get() return o.Value end function o:SetText(t) lbl.Text = t end function o:Destroy() holder:Destroy() end function o:RefreshTheme(nt) th2 = nt holder.BackgroundColor3 = nt.Panel lbl.TextColor3 = nt.Text valLbl.TextColor3 = nt.Accent bar.BackgroundColor3 = nt.PanelLight fill.BackgroundColor3 = nt.Accent knob.BackgroundColor3 = nt.Text end function o:RefreshAccent(c) fill.BackgroundColor3 = c valLbl.TextColor3 = c end
