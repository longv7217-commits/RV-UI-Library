local ActiveDragKind = nil
local function IsPointInGui(gui, point)
    if not gui or not gui.AbsolutePosition then return false end
    local p = gui.AbsolutePosition
    local s = gui.AbsoluteSize
    return point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y
end
local function IsOverInteractive(parent, point)
    if not parent then return false end
    for _, d in ipairs(parent:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") or d:IsA("TextBox") then
            if IsPointInGui(d, point) then return true end
        end
    end
    return false
end
local function MakeDraggable(frame, dragArea, onDrag)
    frame.Active = true
    frame.Draggable = false
    if dragArea then dragArea.Active = true dragArea.Draggable = false end
    local dragging = false
    local dragStart = Vector2.new(0, 0)
    local startAbs = Vector2.new(0, 0)
    local area = dragArea or frame
    TrackConnection(area.InputBegan:Connect(function(input)
        if ActiveDragKind ~= nil then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if IsOverInteractive(area, input.Position) then return end
            dragging = true
            ActiveDragKind = "drag"
            dragStart = input.Position
            startAbs = frame.AbsolutePosition
        end
    end))
    TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and ActiveDragKind == "drag" and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local cam = workspace.CurrentCamera
            local vw = cam and cam.ViewportSize.X or 1200
            local vh = cam and cam.ViewportSize.Y or 800
            local nx = math.clamp(startAbs.X + delta.X, -frame.AbsoluteSize.X + 80, vw - 80)
            local ny = math.clamp(startAbs.Y + delta.Y, 0, vh - 40)
            frame.Position = UDim2.new(0, nx, 0, ny)
            if onDrag then SafeCall(onDrag, frame.Position) end
        end
    end))
    TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then dragging = false if ActiveDragKind == "drag" then ActiveDragKind = nil end end
        end
    end))
    return function() dragging = false if ActiveDragKind == "drag" then ActiveDragKind = nil end end
end
